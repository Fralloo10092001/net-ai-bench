{
  "task_name": "FRR Basic Connectivity",
  "lab_file": "labs/frr-basic.yml",
  "domain": "routing",
  "difficulty": "easy",
  "intents": [
    "Configure the network using exactly the following addressing plan:",
    "Set pc1 eth1 to 10.0.1.2/24 and use 10.0.1.1 as default gateway.",
    "Set r1 eth1 to 10.0.1.1/24.",
    "Set r1 eth2 to 10.0.12.1/24.",
    "Set r2 eth1 to 10.0.12.2/24.",
    "Set r2 eth2 to 10.0.2.1/24.",
    "Set pc2 eth1 to 10.0.2.2/24 and use 10.0.2.1 as default gateway.",
    "Enable IP forwarding on both routers if needed.",
    "Configure static routes so that PC1 and PC2 can ping each other through R1 and R2."
  ],
  "ground_truth_configs": {
    "r1": [
      "ip addr add 10.0.1.1/24 dev eth1",
      "ip addr add 10.0.12.1/24 dev eth2",
      "ip route add 10.0.2.0/24 via 10.0.12.2",
      "echo 1 > /proc/sys/net/ipv4/ip_forward"
    ],
    "r2": [
      "ip addr add 10.0.12.2/24 dev eth1",
      "ip addr add 10.0.2.1/24 dev eth2",
      "ip route add 10.0.1.0/24 via 10.0.12.1",
      "echo 1 > /proc/sys/net/ipv4/ip_forward"
    ],
    "pc1": [
      "ip addr add 10.0.1.2/24 dev eth1",
      "ip route add default via 10.0.1.1"
    ],
    "pc2": [
      "ip addr add 10.0.2.2/24 dev eth1",
      "ip route add default via 10.0.2.1"
    ]
  },
  "ground_truth_reasoning": "",
  "baseline_invariants": [
    {
      "name": "R1 management interface is still up",
      "device": "r1",
      "command": "ip link show eth0",
      "expected_output": "state UP"
    },
    {
      "name": "R2 management interface is still up",
      "device": "r2",
      "command": "ip link show eth0",
      "expected_output": "state UP"
    },
    {
      "name": "R1 still has management default route",
      "device": "r1",
      "command": "ip route show default",
      "expected_output": "default via 172.20.20.1 dev eth0"
    },
    {
      "name": "R2 still has management default route",
      "device": "r2",
      "command": "ip route show default",
      "expected_output": "default via 172.20.20.1 dev eth0"
    },
    {
      "name": "R1 FRR CLI is still reachable",
      "device": "r1",
      "command": "vtysh -c 'show version'",
      "expected_output": "FRRouting"
    },
    {
      "name": "R2 FRR CLI is still reachable",
      "device": "r2",
      "command": "vtysh -c 'show version'",
      "expected_output": "FRRouting"
    }
  ],
  "testcases": [
    {
      "name": "PC1 can ping PC2",
      "device": "pc1",
      "command": "ping -c 3 -W 2 10.0.2.2",
      "expected_output": "3 packets transmitted, 3 packets received"
    },
    {
      "name": "PC2 can ping PC1",
      "device": "pc2",
      "command": "ping -c 3 -W 2 10.0.1.2",
      "expected_output": "3 packets transmitted, 3 packets received"
    },
    {
      "name": "R1 eth1 has correct IP",
      "device": "r1",
      "command": "ip addr show eth1",
      "expected_output": "10.0.1.1/24"
    },
    {
      "name": "R1 eth2 has correct IP",
      "device": "r1",
      "command": "ip addr show eth2",
      "expected_output": "10.0.12.1/24"
    },
    {
      "name": "R2 eth1 has correct IP",
      "device": "r2",
      "command": "ip addr show eth1",
      "expected_output": "10.0.12.2/24"
    },
    {
      "name": "R2 eth2 has correct IP",
      "device": "r2",
      "command": "ip addr show eth2",
      "expected_output": "10.0.2.1/24"
    },
    {
      "name": "PC1 has correct IP",
      "device": "pc1",
      "command": "ip addr show eth1",
      "expected_output": "10.0.1.2/24"
    },
    {
      "name": "PC2 has correct IP",
      "device": "pc2",
      "command": "ip addr show eth1",
      "expected_output": "10.0.2.2/24"
    },
    {
      "name": "R1 has route to PC2 subnet",
      "device": "r1",
      "command": "ip route show",
      "expected_output": "10.0.2.0/24 via 10.0.12.2"
    },
    {
      "name": "R2 has route to PC1 subnet",
      "device": "r2",
      "command": "ip route show",
      "expected_output": "10.0.1.0/24 via 10.0.12.1"
    }
  ]
}