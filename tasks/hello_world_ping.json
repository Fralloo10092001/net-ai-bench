{
  "task_name": "HelloWorld Ping",
  "lab_file": "labs/hello-world.yml",
  "intents": [
    "Configure the router so that PC1 (10.0.1.2) and PC2 (10.0.2.2) can ping each other.",
    "Assign IP 10.0.1.1/24 to the router interface connected to PC1.",
    "Assign IP 10.0.2.1/24 to the router interface connected to PC2.",
    "Enable IP forwarding on the router."
  ],
  "topology": {
    "nodes": [
      "pc1",
      "router",
      "pc2"
    ],
    "links": [
      "pc1:eth1 <-> router:eth1",
      "pc2:eth1 <-> router:eth2"
    ]
  },
  "startup_configs": {
    "pc1": [
      "ip addr add 10.0.1.2/24 dev eth1",
      "ip route add default via 10.0.1.1"
    ],
    "router": [],
    "pc2": [
      "ip addr add 10.0.2.2/24 dev eth1",
      "ip route add default via 10.0.2.1"
    ]
  },
  "ground_truth_configs": {
    "router": [
      "ip addr add 10.0.1.1/24 dev eth1",
      "ip addr add 10.0.2.1/24 dev eth2",
      "echo 1 > /proc/sys/net/ipv4/ip_forward"
    ]
  },
  "ground_truth_reasoning": "The router needs an IP on each interface to act as the default gateway for each subnet. eth1 faces PC1 on 10.0.1.0/24, so it gets 10.0.1.1/24. eth2 faces PC2 on 10.0.2.0/24, so it gets 10.0.2.1/24. Finally, IP forwarding must be enabled so the kernel routes packets between the two subnets.",
  "testcases": [
    {
      "name": "PC1 can ping PC2",
      "device": "pc1",
      "command": "ping -c 3 -W 2 10.0.2.2",
      "expected_output": "3 packets transmitted, 3 packets received"
    },
    {
      "name": "PC2 can ping PC1",
      "device": "pc2",
      "command": "ping -c 3 -W 2 10.0.1.2",
      "expected_output": "3 packets transmitted, 3 packets received"
    },
    {
      "name": "Router eth1 has correct IP",
      "device": "router",
      "command": "ip addr show eth1",
      "expected_output": "10.0.1.1/24"
    },
    {
      "name": "Router eth2 has correct IP",
      "device": "router",
      "command": "ip addr show eth2",
      "expected_output": "10.0.2.1/24"
    },
    {
      "name": "IP forwarding is enabled",
      "device": "router",
      "command": "cat /proc/sys/net/ipv4/ip_forward",
      "expected_output": "1"
    }
  ]
}